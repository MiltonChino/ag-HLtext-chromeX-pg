{
  "manifest_version": 3,
  "name": "Text Highlighter & Sidebar",
  "version": "1.0",
  "description": "Highlight text on any page and save it to a sidebar.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}